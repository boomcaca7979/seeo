# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SEO 数据缓存（含 API 用量计数，禁止提交）
/data/cache/

# SQLite 数据库（本地持久化数据，禁止提交）
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm

# E｜潜客数据库（内部数据，含真实联系人邮箱，禁止提交/禁止进 client bundle）
/seo-growth/leads.csv
/seo-growth/leads.csv.tmp

# E｜Send Ledger（Resend 实际发件记录导出，含真实收件地址，禁止提交）
# 这是「历史 outreach 的最高可信来源」，与 leads.csv 同级敏感；只做对账，不是第二份潜客库。
/seo-growth/send-ledger.csv
/seo-growth/send-ledger.csv.tmp
